import socket
import threading
import queue
import tkinter as tk
from tkinter import scrolledtext

# Use 0.0.0.0 to listen on all interfaces
UDP_IP = "0.0.0.0" 
UDP_PORT = 12345

msg_queue = queue.Queue()

def udp_listener():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind((UDP_IP, UDP_PORT))

    print(f"Listening on port {UDP_PORT}... (Press Ctrl+C to stop)")

    while True:
        try:
            data, addr = sock.recvfrom(1024)
            # print(f"Received from {addr}: {data.decode()}")
            message = data.decode()
            if message:
                reply = "PC CONNECTED!"
                msg_queue.put(f"{addr[0]}:{addr[1]} -> {message}")
                sock.sendto(reply.encode(), addr)
                # print(f"Send {reply} to {addr}")
        except Exception as e:
            print(f"Error: {e}")



def update_ui():
    while not msg_queue.empty():
        msg = msg_queue.get()
        text_area.insert(tk.END, msg + "\n")
        text_area.see(tk.END)
    root.after(100, update_ui)



root = tk.Tk()
root.title("ESP32 UDP Monitor")
root.geometry("700x500")

label = tk.Label(root, text = "Incomming ESP32 Data", font = ("Arial", 14))
label.pack(pady=5)

text_area = scrolledtext.ScrolledText(
    root,
    width = 90,
    height = 25,
    font = ("Consolas", 11)
)
text_area.pack(padx = 10, pady = 10)

threading.Thread(target = udp_listener, daemon = True).start()

root.after(100, update_ui)

root.mainloop()